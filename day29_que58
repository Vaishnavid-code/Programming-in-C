//Q58: Find the maximum and minimum element in an array.
#include<stdio.h>
int main()
{
int n,i;

printf("Enter n:");
scanf("%d",&n);

int arr[n];

printf("Enter n numbers:");
  for(i=0;i<n;i++)
  {
    scanf("%d",&arr[i]);  
  }    
  int max=arr[0];
  for(i=0;i<n;i++)
  {         
    if (arr[i]>max)
      max=arr[i];                          
  }
  int min=arr[0];             
  for(i=0;i<n;i++)
  {   
    if (arr[i]<min)        
      min=arr[i];       
  }
   
  printf("Max=%d, Min=%d",max,min);    
    
return 0;
}
