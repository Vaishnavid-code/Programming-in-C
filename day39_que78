//Q78: Find the sum of main diagonal elements for a square matrix.
#include <stdio.h>
int main()
{
int n,i,j;
int sum=0;

scanf("%d %d",&n,&j);

int matrix[n][j];

for(i=0;i<n;i++)
{
for(j=0;j<n;j++)
  {
    scanf("%d",&matrix[i][j]);
  }
}
for(i=0;i<n;i++)
{
  sum=sum+matrix[i][i];
}
printf("%d",sum);
return 0;
}
