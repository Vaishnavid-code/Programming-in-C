//Q75: Add two matrices.
#include <stdio.h>
int main()
{
int rows,cols,i,j;

scanf("%d %d",&rows,&cols);

int matrix1[rows][cols];
int matrix2[rows][cols];
int sum[rows][cols];

for(i=0;i<rows;i++)
{
  for(j=0;j<cols;j++)
  {
    scanf("%d",&matrix1[i][j]);
  }
}

scanf("%d %d",&rows,&cols);
for(i=0;i<rows;i++)
{
  for(j=0;j<cols;j++)
  {
    scanf("%d",&matrix2[i][j]);
  }
}
for(i=0;i<rows;i++)
{
  for(j=0;j<cols;j++)
  {
    sum[i][j]=matrix1[i][j]+matrix2[i][j];
  }
}
for(i = 0; i < rows; i++)
{
  for(j = 0; j < cols; j++)
  {
    printf("%d ", sum[i][j]);
  }
  printf("\n");
}
return 0;
}
