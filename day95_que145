//Q145: Return a structure containing top student's details from a function.
#include <stdio.h>
struct Student 
{
    char name[50];
    int roll_no;
    int marks;
};

struct Student findTopper(struct Student s[]) 
{
int i, max = 0;

for (i = 1; i < 3; i++) 
{
  if (s[i].marks > s[max].marks) 
  {
    max = i;
  }
}

return s[max];
}

int main() 
{
struct Student s[3], topper;
int i;

for (i = 0; i < 3; i++) 
{
  scanf("%s %d %d", s[i].name,
        &s[i].roll_no, &s[i].marks);
}

topper = findTopper(s);

printf("Top Student: %s | Roll: %d | Marks: %d",
      topper.name, topper.roll_no, topper.marks);

return 0;
}
