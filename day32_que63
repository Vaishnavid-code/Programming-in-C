//Q63: Merge two arrays.
#include<stdio.h>
int main()
{
int n,m,i,j,k;

printf("Enter n:");
scanf("%d",&n);

int arr1[n];

printf("Enter elements:");
  for(i=0;i<n;i++)
  {
    scanf("%d",&arr1[i]);
  }

printf("Enter m:");
scanf("%d",&m);

int arr2[m];

printf("Enter elements:");
for(j=0;j<m;j++)
{
  scanf("%d",&arr2[j]);
}

int a=n+m;

int arrnew[a];

for(i=0;i<n;i++)
  arrnew[i]=arr1[i];

for(j=0;j<m;j++)
  arrnew[n+j]=arr2[j];

for(k=0;k<a;k++)
  printf("%d",arrnew[k]);    
  
return 0;
}
