//Q34: Write a program to check if a number is prime.
#include<stdio.h>
int main()
{
int num,i,count=1;
printf("Enter a number: ");
scanf("%d",&num);

if(num<=1)
{
  count=0;  
}  
else
{
  for (i=2;i*i<=num;i++)
  {
    if(num%i==0)
    {
      count=0;
      break;            
    }       
   }  
}
if (count)
  printf("Prime");
else
  printf("Not Prime");  
return 0;
}
