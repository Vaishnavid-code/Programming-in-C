//Q76: Check if a matrix is symmetric.
#include <stdio.h>
int main()
{
int n,m,i,j;
int isSymmetric=1;

scanf("%d %d",&n,&m);

int matrix[n][m];

for(i=0;i<n;i++)
{
  for(j=0;j<m;j++)
   {
     scanf("%d",&matrix[i][j]);
   }
}
if(n!=m)
{
  isSymmetric=0;
}
else
 {
   for(i = 0; i < n; i++)
    {
      for(j = 0; j < n; j++)
       {
         if(matrix[i][j] != matrix[j][i])
          {
            isSymmetric = 0;
            break;
          }
       }
      if(isSymmetric == 0)
      break;
    }
 }
if(isSymmetric)
  printf("True");
else
  printf("False");
return 0;
}
