//Q96: Reverse each word in a sentence without changing the word order.
#include<stdio.h>
int main()
{
char str[200];
    int i = 0, start = 0, end;

    scanf("%[^\n]", str);

    while(1)
    {
        if(str[i] == ' ' || str[i] == '\0')
        {
            end = i - 1;

            // Print current word in reverse
            while(end >= start)
            {
                printf("%c", str[end]);
                end--;
            }

            if(str[i] == ' ')
                printf(" ");

            start = i + 1;
        }

        if(str[i] == '\0')
            break;

        i++;
    }

    return 0;
}
