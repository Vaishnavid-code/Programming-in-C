//Q25: Write a program to implement a basic calculator using switch-case for +, -, *, /, %.

#include<stdio.h>
int main()
{
char op;
int num1,num2;

printf("enter two numbers:");
scanf("%d%d",&num1,&num2);

printf("Enter a operator:");
scanf(" %c",&op);

switch(op)
    {
    case '+':
        printf("%d",num1+num2);
    break;        
    case '-':
        printf("%d",num1-num2); 
    break;        
    case '*':
        printf("%d",num1*num2);
    break;        
    case '/':
        printf("%d",num1/num2);
    break;        
    case '%':
        printf("%d",num1%num2); 
    break;        
    default:
        printf("Invalid input");  
    }         
                                                            
return 0;  
}
