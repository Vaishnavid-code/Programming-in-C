//Q9: Write a program to calculate simple and compound interest for given principal, rate, and time.

#include<stdio.h>
#include<math.h>
int main()
{
float SI,P,R,T,CI;
printf("Enter P,R,T");
scanf("%f%f%f",&P,&R,&T);

SI=(P*R*T)/100;
CI=P*(pow((1+(R/100)),T)-1); 

printf("Simple Interest=%f,Compound Interest=%f",SI,CI);  
return 0;
}
