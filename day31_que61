//Q61: Search for an element in an array using linear search.
#include<stdio.h>
int main()
{
int n,i,x;

printf("Enter n:");
scanf("%d",&n);

int arr[n];

printf("Enter n Elements:");
for(i=0;i<n;i++)
  {
  scanf("%d",&arr[i]);
  }
  
  printf("Enter element:");
  scanf("%d",&x);
  
for(i=0;i<n;i++)
{
  if(arr[i]==x)
  {
   printf("Found at index %d",i); 
   break;        
  }   
}   
  if(arr[i-1]!=x)
  printf("-1");               
return 0;
}
