//Q119: Write a program to take an integer array as input. Only one element will be repeated. Print the repeated element. Try to find the result in one single iteration.
#include<stdio.h>
int main()
{
int n,i;
int found=-1;

scanf("%d",&n);

int arr[n];
int count[1001]={0};

for(i=0;i<n;i++) 
{
  scanf("%d",&arr[i]);
}

for(i=0;i<n;i++) 
{
  if(count[arr[i]]==1) 
  {
    found=arr[i];
    break;
  }
  count[arr[i]]++;
}

printf("%d",found);

return 0;
}
