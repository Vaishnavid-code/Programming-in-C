//Q12: Write a program to input an integer and check whether it is positive, negative or zero using nested if–else.

#include<stdio.h>
#include<math.h>
int main()
{
int n;
printf("Enter n:");
scanf("%d",&n);

if(n==0)
{
printf("zero");
}
if(n>0)
{
printf("Positive");
}
if(n<0)
{
printf("Negative");
}  
return 0;
}
